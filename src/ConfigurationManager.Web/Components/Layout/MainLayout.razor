@inherits LayoutComponentBase
@implements IDisposable
@inject ConfigurationManager.Web.Services.CurrentSession Session

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (Session.IsSignedIn)
            {
                <span>Signed in as <strong>@Session.DisplayName</strong> (@Session.Role)</span>
            }
            else
            {
                <span class="text-warning">Not signed in - <a href="login">sign in</a> to browse configuration.</span>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}
